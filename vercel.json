{
  "version": 2,
  "name": "camboai-platform",
  "builds": [
    {
      "src": "web-advanced/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web-advanced/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://camboai-api.onrender.com",
    "NEXT_PUBLIC_WS_URL": "wss://camboai-api.onrender.com",
    "NODE_ENV": "production"
  },
  "functions": {
    "web-advanced/pages/api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "regions": ["iad1"],
  "framework": "nextjs"
}