{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Frontend: install and build",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"npm ci --no-audit --no-fund; npm run build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint - stylish"
			],
			"group": "build"
		},
		{
			"label": "Frontend: install and build",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm ci --no-audit --no-fund && npm run build"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}