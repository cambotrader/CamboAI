{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"terminal.integrated.stickyScroll.enabled": true,
		"terminal.integrated.suggest.enabled": true,
		"CodeGPT.apiKey": "Nvidia",
		"zencoder.mcpServers": {
			"agentql": {
				"command": "npx",
				"args": [
					"-y",
					"agentql-mcp"
				],
				"env": {
					"AGENTQL_API_KEY": "YOUR_API_KEY"
				}
			},
			"cloudflare": {
				"command": "npx",
				"args": [
					"mcp-remote",
					"https://observability.mcp.cloudflare.com/sse"
				]
			},
			"firecrawl": {
				"command": "npx",
				"args": [
					"-y",
					"firecrawl-mcp"
				],
				"env": {
					"FIRECRAWL_API_KEY": "YOUR_API_KEY"
				}
			},
			"git": {
				"command": "uvx",
				"args": [
					"mcp-server-git"
				]
			}
		}
	}
}